{
  "name": "mavon-engine-monorepo",
  "private": true,
  "workspaces": [
    "packages/bootstrap",
    "packages/core",
    "packages/editor",
    "packages/cli",
    "packages/plugins/*"
  ],
  "devDependencies": {
    "@antfu/eslint-config": "10.0.0",
    "bcryptjs": "^3.0.3",
    "eslint": "10.15.0",
    "iwer": "^2.8.0",
    "playwright-core": "^1.65.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.1"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "test:plugin-e2e": "node e2e/plugin/run.mjs",
    "test:make-plugin-e2e": "node e2e/make-plugin/run.mjs",
    "test:monitoring-e2e": "node e2e/http-monitoring/run.mjs",
    "test:sqlite-e2e": "node e2e/sqlite/run.mjs",
    "test:auth-e2e": "node e2e/auth/run.mjs",
    "test:mail-e2e": "node e2e/mail/run.mjs",
    "test:scenes-e2e": "node e2e/scenes/run.mjs",
    "test:mcp-e2e": "node e2e/mcp/run.mjs",
    "test:editor-dist-e2e": "node e2e/editor-dist/run.mjs",
    "test:doctor-e2e": "node e2e/doctor/run.mjs",
    "test:upgrade-e2e": "node e2e/upgrade/run.mjs",
    "test:xr-e2e": "node e2e/xr/run.mjs"
  }
}
