{
  "name": "@mavonengine/mail",
  "type": "module",
  "version": "0.0.2",
  "description": "MavonEngine plugin: send mail from the game server, queued and retried, through a transport plugin such as @mavonengine/smtp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MavonEngine/Core.git",
    "directory": "packages/plugins/mail"
  },
  "keywords": [
    "mavonengine",
    "mavonengine-plugin",
    "mail",
    "email"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "publish"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.json --emitDeclarationOnly",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "peerDependencies": {
    "@mavonengine/core": ">=0.0.25",
    "maildev": "^3.0.0"
  },
  "mavonengine": {
    "target": "server",
    "server": "./dist/index.js",
    "dev": "./dist/dev.js",
    "publish": "publish",
    "engine": ">=0.0.25"
  },
  "peerDependenciesMeta": {
    "maildev": {
      "optional": true
    }
  },
  "dependencies": {
    "nodemailer": "^10.3.1"
  },
  "devDependencies": {
    "@geckos.io/server": "^3.1.0",
    "@mavonengine/core": "*",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "maildev": "^3.0.0",
    "tsup": "^9.0.0",
    "typescript": "7.0.2",
    "vitest": "^5.1.1",
    "winston": "^3.19.0"
  }
}
