{
  "name": "@mavonengine/notifications",
  "type": "module",
  "version": "0.0.1",
  "description": "MavonEngine plugin: notifications for players and anything else notifiable, in the game and by mail",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MavonEngine/Core.git",
    "directory": "packages/plugins/notifications"
  },
  "keywords": [
    "mavonengine",
    "mavonengine-plugin",
    "notifications"
  ],
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.json --emitDeclarationOnly",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "peerDependencies": {
    "@mavonengine/core": ">=0.0.25"
  },
  "devDependencies": {
    "@geckos.io/server": "^3.1.0",
    "@mavonengine/core": "*",
    "@mavonengine/mail": "*",
    "@types/node": "^24.0.0",
    "kysely": "^0.29.8",
    "tsup": "^9.0.0",
    "typescript": "7.0.2",
    "vitest": "^5.1.1",
    "winston": "^3.19.0"
  },
  "mavonengine": {
    "target": "both",
    "client": "./dist/client.js",
    "server": "./dist/server.js",
    "engine": ">=0.0.25"
  }
}
