    {
      "id": "about",
      "type": "graph.comment",
      "position": [
        20,
        46
      ],
      "values": {
        "text": "Runs on the server, with the Server NPC as Self: the Logic Graph object in the scene names it as its target. On Start remembers where the NPC started along x, so it knows how far it has walked.",
        "width": 700,
        "height": 80
      },
      "group": "group_start"
    },
    {
      "id": "about_walking",
      "type": "graph.comment",
      "position": [
        20,
        526
      ],
      "values": {
        "text": "Every tick: walk along x by direction \u00d7 speed \u00d7 delta, then face that way. dir, speed and range are this graph's parameters. Rotation y follows the players' convention: \u221290\u00b0 (\u22121.5708) faces +x, so yaw = dir \u00d7 \u22121.5708.",
        "width": 920,
        "height": 90
      },
      "group": "group_walk"
    },
    {
      "id": "about_turning",
      "type": "graph.comment",
      "position": [
        1060,
        526
      ],
      "values": {
        "text": "Turn around: (x \u2212 start) \u00d7 dir is how far the NPC is past its start in the direction it walks. Once that reaches range, Branch flips dir. The same test covers both ends.",
        "width": 960,
        "height": 90
      },
      "group": "group_turn"
    },
    {
      "id": "about_clicked",
      "type": "graph.comment",
      "position": [
        20,
        1306
      ],
      "values": {
        "text": "Clicked: when a player clicks the NPC, the server sends `clicked` to the graphs acting on it. Cooldown lets it answer at most once every 10 seconds (clicks sooner do nothing), then Say in Chat posts as the NPC.",
        "width": 840,
        "height": 80
      },
      "group": "group_clicked"
    },
